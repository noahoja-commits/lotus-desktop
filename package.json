{
  "name": "lotus-desktop",
  "productName": "Lotus",
  "version": "1.0.0",
  "description": "Lotus — what a lottery ticket is really worth",
  "author": "Noah",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "dist": "vite build && electron-builder --win portable"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "net.noah.lotus",
    "productName": "Lotus",
    "directories": { "output": "release" },
    "files": [ "dist/**/*", "electron/**/*" ],
    "win": { "target": "portable" },
    "portable": { "artifactName": "Lotus-${version}-portable.exe" }
  }
}
